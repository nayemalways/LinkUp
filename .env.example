# ==========================================
# Server
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# Database
# ==========================================
MONGO_URI=

# ==========================================
# JWT Authentication
# ==========================================
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRATION=15m

JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=7d

# ==========================================
# Password / Bcrypt
# ==========================================
BCRYPT_SALT_ROUND=10

# ==========================================
# OTP JWT
# ==========================================
OTP_JWT_ACCESS_EXPIRATION=10m
OTP_JWT_ACCESS_SECRET=

# ==========================================
# Frontend
# ==========================================
FRONTEND_URL=http://localhost:5173

# ==========================================
# Twilio
# ==========================================
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# ==========================================
# Cloudinary
# ==========================================
CLOUDINARY_SECRET=
CLOUDINARY_API_KEY=
CLOUDINARY_NAME=

# ==========================================
# Admin
# ==========================================
ADMIN_GMAIL=
ADMIN_PASSWORD=

# ==========================================
# Redis
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==========================================
# Rate Limiting
# ==========================================
REQUEST_RATE_LIMIT=100
REQUEST_RATE_LIMIT_TIME=15

# ==========================================
# Email / SMTP
# ==========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_FROM=
EMAIL_FROM_NAME=
EMAIL_PASSWORD=

# ==========================================
# Google OAuth
# ==========================================
GOOGLE_OAUTH_ID=
GOOGLE_OAUTH_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ==========================================
# Google Maps
# ==========================================
GOOGLE_MAP_API_KEY=

# ==========================================
# Express Session
# ==========================================
EXPRESS_SESSION_SECRET=

# ==========================================
# Firebase / Google Service Account
# ==========================================
TYPE=service_account
PROJECT_ID=
PRIVATE_KEY_ID=
PRIVATE_KEY=
CLIENT_EMAIL=
CLIENT_ID=
AUTH_URI=https://accounts.google.com/o/oauth2/auth
TOKEN_URI=https://oauth2.googleapis.com/token
AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
CLIENT_X509_CERT_URL=
UNIVERSE_DOMAIN=googleapis.com

# ==========================================
# Stripe
# ==========================================
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_SPONSORED_WEBHOOK_SECRET=